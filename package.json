{
  "name": "tetra",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@openrouter/ai-sdk-provider": "2.10.0",
      "@types/bun": "1.3.14",
      "@types/node": "24.12.4",
      "@types/react": "19.2.17",
      "@types/react-dom": "19.2.3",
      "ai": "6.0.191",
      "lucide-react": "1.23.0",
      "react": "19.2.7",
      "react-dom": "19.2.7",
      "shiki": "4.0.2",
      "tailwindcss": "4.3.2",
      "tinybase": "8.5.0",
      "typescript": "6.0.3",
      "zod": "4.4.3"
    }
  },
  "type": "module",
  "scripts": {
    "build": "bun run --cwd apps/web build",
    "build:vercel": "bun run build",
    "check": "ultracite check --type-aware --type-check",
    "cli": "bun run --cwd apps/cli start",
    "dev": "bun run --cwd apps/web dev",
    "fix": "ultracite fix --type-aware --type-check",
    "knip": "knip",
    "preview": "bun run build && bun run --cwd apps/web preview",
    "reset-sync": "bun run --cwd apps/cli start sync reset --yes",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "knip": "^6.24.0",
    "lefthook": "^2.1.9",
    "oxfmt": "0.57.0",
    "oxlint": "1.72.0",
    "oxlint-tsgolint": "0.24.0",
    "typescript": "catalog:",
    "ultracite": "7.8.4"
  },
  "overrides": {
    "shiki": "^4.0.2"
  },
  "packageManager": "bun@1.3.14"
}
